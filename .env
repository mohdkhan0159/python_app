# ========================================
# LOCAL DEVELOPMENT ENVIRONMENT
# ========================================
# This file is used for local development only.
# In production (AKS), settings are loaded from Azure Key Vault.

# -----------------------------
# ENVIRONMENT
# -----------------------------
ENV=local

# -----------------------------
# SESSION SECRET
# -----------------------------
SESSION_SECRET=super-secret-local-key-123456789

# -----------------------------
# DATABASE (LOCAL SQLite)
# -----------------------------
DATABASE_URL=sqlite+aiosqlite:///./learning_platform.db

# -----------------------------
# AZURE SETTINGS (NOT USED LOCALLY)
# These are empty in local development.
# The app will use local SQLite and local file storage.
# In production, these come from Azure Key Vault.
# -----------------------------
# AZURE_SQL_CONNECTION_STRING=
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=uploads
